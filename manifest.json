{
  "manifest_version": 3,
  "name": "Endstep MTGO Skin",
  "version": "1.2.0",
  "description": "Gives endstep.cc the look and layout of Magic: The Gathering Online. Visual only, collects no data.",
  "author": "@imcoesus",
  "homepage_url": "https://x.com/imcoesus",
  "permissions": ["storage"],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MTGO Skin",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "content_scripts": [
    {
      "matches": ["https://endstep.cc/*"],
      "css": ["mtgo.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
